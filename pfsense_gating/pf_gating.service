#!/bin/sh
# PROVIDE: pf_gating
# REQUIRE: NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="pf_gating"
rcvar="pf_gating_enable"

load_rc_config "$name"
: "${pf_gating_enable:=YES}"

command="/usr/sbin/daemon"
pidfile="/var/run/${name}.pid"
required_files="/usr/local/etc/pf_gating/g.conf"
command_args="-f -r -P ${pidfile} -o /var/log/${name}.log /bin/sh /usr/local/libexec/pf_gating/pf_gating"

run_rc_command "${1:-start}"