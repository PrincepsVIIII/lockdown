#!/usr/bin/env python3
"""Send pop-up messages to Linux desktops. No pip packages required."""

import argparse
import ast
from concurrent.futures import ThreadPoolExecutor
import hashlib
import hmac
import html
import json
import os
from pathlib import Path
import re
import secrets
import shutil
import socket
import subprocess
import sys
import threading
import time
from http.client import HTTPException
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.error import HTTPError, URLError
from urllib.parse import urlsplit
from urllib.request import HTTPRedirectHandler, ProxyHandler, Request, build_opener


PORT = 8765
MAX_BODY = 32768
CLOCK_WINDOW = 60
IO_TIMEOUT = 5


def config_dir():
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def default_key():
    return config_dir() / "notify" / "key"


def read_key(path):
    try:
        with Path(path).expanduser().open("r", encoding="ascii") as handle:
            value = handle.read(1024).strip()
    except FileNotFoundError:
        raise ValueError("Key file not found. Generate it on the sender with 'notify keygen' and copy it to each receiver.") from None
    if not re.fullmatch(r"[0-9a-fA-F]{64}", value):
        raise ValueError("Key file must contain the 64 hexadecimal characters produced by 'notify keygen'.")
    return bytes.fromhex(value)


def keygen(args):
    path = Path(args.key_file).expanduser().resolve()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        raise ValueError("Key already exists: {} (left unchanged).".format(path)) from None
    with os.fdopen(fd, "w", encoding="ascii") as handle:
        handle.write(secrets.token_hex(32) + "\n")
    print("Created {}. Copy this same file securely to each receiver.".format(path))
    return 0


def validate_message(data):
    if not isinstance(data, dict):
        raise ValueError("Message must be a JSON object.")
    if set(data) - {"title", "message", "urgency", "duration"}:
        raise ValueError("Unknown message field.")
    title = data.get("title", "Message")
    message = data.get("message")
    urgency = data.get("urgency", "normal")
    duration = data.get("duration", 8)
    for name, value, limit in (("title", title, 200), ("message", message, 4000)):
        if not isinstance(value, str) or not value.strip() or len(value) > limit:
            raise ValueError("{} must contain 1-{} characters.".format(name, limit))
        if any(ord(char) < 32 and char not in "\n\t" for char in value):
            raise ValueError("{} contains an unsupported control character.".format(name))
        try:
            value.encode("utf-8")
        except UnicodeEncodeError:
            raise ValueError("{} contains invalid Unicode.".format(name)) from None
    if urgency not in ("low", "normal", "critical"):
        raise ValueError("Urgency must be low, normal, or critical.")
    if type(duration) is not int or not 1 <= duration <= 300:
        raise ValueError("Duration must be an integer from 1 to 300 seconds.")
    return {"title": title, "message": message, "urgency": urgency, "duration": duration}


def show_popup(data):
    # An argument list, '--', and escaped body markup keep received text literal.
    subprocess.run(
        ["notify-send", "--app-name=notify", "--icon=dialog-information",
         "--urgency=" + data["urgency"],
         "--expire-time=" + str(data["duration"] * 1000), "--",
         data["title"], html.escape(data["message"], quote=False)],
        check=True, capture_output=True, timeout=IO_TIMEOUT,
    )


def signature(key, timestamp, nonce, body):
    prefix = "POST\n/notify\n{}\n{}\n".format(timestamp, nonce).encode("ascii")
    return hmac.new(key, prefix + body, hashlib.sha256).hexdigest()


def signed_headers(key, body):
    timestamp = str(int(time.time()))
    nonce = secrets.token_hex(16)
    return {
        "Content-Type": "application/json",
        "X-Notify-Timestamp": timestamp,
        "X-Notify-Nonce": nonce,
        "X-Notify-Signature": signature(key, timestamp, nonce, body),
    }


class NotifyServer(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, address, key=None, popup=show_popup):
        self.key = key
        self.popup = popup
        self.nonces = {}
        self.auth_lock = threading.Lock()
        self.slots = threading.BoundedSemaphore(8)
        super().__init__(address, NotifyHandler)

    def get_request(self):
        connection, address = super().get_request()
        connection.settimeout(IO_TIMEOUT)
        return connection, address

    def process_request(self, request, client_address):
        if not self.slots.acquire(blocking=False):
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, client_address)
        except BaseException:
            self.slots.release()
            raise

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self.slots.release()

    def authenticate(self, headers, body):
        if self.key is None:
            return True
        timestamp = headers.get("X-Notify-Timestamp", "")
        nonce = headers.get("X-Notify-Nonce", "")
        digest = headers.get("X-Notify-Signature", "")
        if not (re.fullmatch(r"[0-9]{1,12}", timestamp)
                and re.fullmatch(r"[0-9a-f]{32}", nonce)
                and re.fullmatch(r"[0-9a-f]{64}", digest)):
            return False
        now = time.time()
        if abs(now - int(timestamp)) > CLOCK_WINDOW:
            return False
        if not hmac.compare_digest(digest, signature(self.key, timestamp, nonce, body)):
            return False
        with self.auth_lock:
            self.nonces = {n: expiry for n, expiry in self.nonces.items() if expiry >= now}
            if nonce in self.nonces or len(self.nonces) >= 4096:
                return False
            self.nonces[nonce] = int(timestamp) + CLOCK_WINDOW
        return True


class NotifyHandler(BaseHTTPRequestHandler):
    server_version = "notify/1.0"
    sys_version = ""

    def log_message(self, format_string, *args):
        # Do not log received text, keys, or client-controlled headers.
        pass

    def reply(self, status, message):
        body = json.dumps({"ok": status == 200, "message": message}).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)
        self.close_connection = True

    def do_POST(self):
        try:
            self.receive()
        except (OSError, TimeoutError):
            # Disconnected and slow clients must not crash the listener.
            self.close_connection = True

    def receive(self):
        if self.path != "/notify":
            self.reply(404, "Unknown endpoint.")
            return
        lengths = self.headers.get_all("Content-Length", [])
        if self.headers.get("Transfer-Encoding") or len(lengths) != 1 or not re.fullmatch(r"[0-9]{1,8}", lengths[0]):
            self.reply(400, "A single Content-Length is required; chunked requests are unsupported.")
            return
        length = int(lengths[0])
        if not 0 < length <= MAX_BODY:
            self.reply(413, "Message body is too large or empty.")
            return
        if self.headers.get_content_type() != "application/json":
            self.reply(415, "Content-Type must be application/json.")
            return
        body = self.rfile.read(length)
        if len(body) != length:
            self.reply(400, "Incomplete message body.")
            return
        if not self.server.authenticate(self.headers, body):
            self.reply(401, "Authentication failed. Check the shared key and both machines' clocks.")
            return
        try:
            data = validate_message(json.loads(body.decode("utf-8")))
        except (ValueError, RecursionError):
            self.reply(400, "Invalid message. Check the title, message, urgency, and duration.")
            return
        try:
            self.server.popup(data)
        except (OSError, subprocess.SubprocessError):
            self.reply(503, "Desktop notification failed. Run the receiver inside a logged-in Linux desktop with notify-send installed.")
            return
        self.reply(200, "Accepted by desktop notification service.")


def desktop_available(environment=None):
    if not sys.platform.startswith("linux"):
        raise ValueError("Receiving pop-ups requires a Linux desktop. Sending works on other platforms too.")
    if not shutil.which("notify-send"):
        raise ValueError("notify-send is missing. Install libnotify-bin (Debian/Ubuntu) or libnotify (Fedora/Arch).")
    environment = os.environ if environment is None else environment
    if not (environment.get("DISPLAY") or environment.get("WAYLAND_DISPLAY")):
        raise ValueError("No desktop session found. Run this as the logged-in user from a desktop terminal.")


def desktop_environment():
    """Use the desktop environment saved by the user's session manager over SSH."""
    environment = os.environ.copy()
    if environment.get("DISPLAY") or environment.get("WAYLAND_DISPLAY"):
        return environment
    if sys.platform.startswith("linux") and shutil.which("systemctl"):
        runtime = Path("/run/user") / str(os.getuid())
        if (runtime / "bus").exists():
            environment.setdefault("XDG_RUNTIME_DIR", str(runtime))
            environment.setdefault("DBUS_SESSION_BUS_ADDRESS", "unix:path=" + str(runtime / "bus"))
            try:
                result = subprocess.run(["systemctl", "--user", "show-environment"],
                                        env=environment, capture_output=True, text=True,
                                        check=True, timeout=IO_TIMEOUT)
            except (OSError, subprocess.SubprocessError):
                return environment
            for line in result.stdout.splitlines():
                name, separator, value = line.partition("=")
                if separator and name in {"DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY",
                                          "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS"}:
                    if value.startswith("$'"):
                        try:
                            value = ast.literal_eval(value[1:])
                        except (ValueError, SyntaxError):
                            continue
                    environment[name] = value
    return environment


def listener_reachable(host, port):
    host = "127.0.0.1" if host == "0.0.0.0" else host
    try:
        with socket.create_connection((host, port), timeout=0.2):
            return True
    except OSError:
        return False


def background_listen(args):
    environment = desktop_environment()
    if args.if_desktop and not (environment.get("DISPLAY") or environment.get("WAYLAND_DISPLAY")):
        print("No active desktop session found; the receiver will start at the next graphical login.")
        return 0
    desktop_available(environment)
    if args.key_file is not None:
        read_key(args.key_file)
    if listener_reachable(args.host, args.port):
        print("Port {}:{} already has a listener. Stop any manually started receiver before switching to background mode.".format(args.host, args.port))
        return 0
    log_path = config_dir() / "notify" / "receiver.log"
    log_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    argv = [sys.executable, str(Path(__file__).resolve()), "listen", "--host", args.host,
            "--port", str(args.port)]
    if args.key_file is not None:
        argv.extend(["--key-file", str(Path(args.key_file).expanduser().resolve())])
    with log_path.open("a", encoding="utf-8") as log:
        process = subprocess.Popen(argv, env=environment, stdin=subprocess.DEVNULL,
                                   stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    deadline = time.monotonic() + IO_TIMEOUT
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise ValueError("Receiver failed to start. See {}.".format(log_path))
        if listener_reachable(args.host, args.port):
            print("Receiver running in the background (PID {}). Log: {}".format(process.pid, log_path))
            return 0
        time.sleep(0.05)
    process.terminate()
    try:
        process.wait(timeout=IO_TIMEOUT)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()
    raise ValueError("Receiver did not start listening. See {}.".format(log_path))


def listen(args):
    if args.background:
        return background_listen(args)
    if args.if_desktop:
        raise ValueError("--if-desktop requires --background.")
    key = read_key(args.key_file) if args.key_file is not None else None
    desktop_available()
    with NotifyServer((args.host, args.port), key) as server:
        print("notify listening on {}:{}; Ctrl+C to stop.".format(*server.server_address), flush=True)
        print("On the sender, run 'notify send HOST \"Hello\"'{}.".format(
            " from a machine with the same key" if key is not None else ""), flush=True)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            print("\nnotify stopped.")
    return 0


class NoRedirect(HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def target_url(target):
    parsed = urlsplit(target if "://" in target else "http://" + target)
    if (parsed.scheme not in ("http", "https") or not parsed.hostname
            or parsed.username is not None or parsed.password is not None
            or parsed.path not in ("", "/") or parsed.query or parsed.fragment):
        raise ValueError("Target must be a hostname or http(s)://host[:port], without a path.")
    port = parsed.port if parsed.port is not None else PORT
    if not 1 <= port <= 65535:
        raise ValueError("Target port must be between 1 and 65535.")
    host = "[{}]".format(parsed.hostname) if ":" in parsed.hostname else parsed.hostname
    return "{}://{}:{}/notify".format(parsed.scheme, host, port)


def octet_values(expression):
    """Expand one IPv4 octet: a number, an inclusive range, or a list."""
    if expression.startswith("(") and expression.endswith(")"):
        entries = expression[1:-1].split(",")
    else:
        entries = [expression]
    values = []
    for entry in entries:
        match = re.fullmatch(r"([0-9]{1,3})(?:-([0-9]{1,3}))?", entry.strip())
        if not match:
            raise ValueError("Invalid IPv4 octet '{}'; use 10, 10-20, or (10,20,30).".format(expression))
        start = int(match[1])
        end = int(match[2]) if match[2] is not None else start
        if not 0 <= start <= end <= 255:
            raise ValueError("IPv4 octets must be 0-255 and ranges must be ascending: '{}'.".format(expression))
        values.extend(range(start, end + 1))
    return list(dict.fromkeys(values))


def expand_target(target):
    """Expand ranges/lists in the second and fourth octets; preserve ports/TLS."""
    target_url(target)  # Validate the complete target before expanding it.
    has_scheme = "://" in target
    parsed = urlsplit(target if has_scheme else "http://" + target)
    host = parsed.hostname
    if not re.fullmatch(r"[0-9().,\s-]+", host) or not any(char in host for char in "-(),"):
        return [target]
    octets = host.split(".")
    if len(octets) != 4 or any(not re.fullmatch(r"[0-9]{1,3}", octets[index]) for index in (0, 2)):
        raise ValueError("IPv4 ranges and lists are supported only in the second and fourth octets.")
    first, second, third, fourth = [octet_values(part) for part in octets]
    prefix = parsed.scheme + "://" if has_scheme else ""
    suffix = ":{}".format(parsed.port) if parsed.port is not None else ""
    return ["{}{}.{}.{}.{}{}".format(prefix, first[0], a, third[0], b, suffix)
            for a in second for b in fourth]


def expand_targets(targets):
    expanded = {}
    for target in targets:
        for host in expand_target(target):
            expanded.setdefault(target_url(host), host)
    return list(expanded.values())


def send_one(target, key, body):
    # Direct LAN connections; do not send messages through ambient HTTP proxies.
    opener = build_opener(ProxyHandler({}), NoRedirect())
    try:
        headers = signed_headers(key, body) if key is not None else {"Content-Type": "application/json"}
        request = Request(target_url(target), data=body, headers=headers, method="POST")
        with opener.open(request, timeout=IO_TIMEOUT + 2) as response:
            reply = json.loads(response.read(MAX_BODY).decode("utf-8"))
            if response.status != 200 or not isinstance(reply, dict) or reply.get("ok") is not True:
                raise ValueError("Receiver did not accept the notification.")
        return True, "{}: sent".format(target)
    except HTTPError as exc:
        details = {401: "key mismatch, clock difference, or replayed request",
                   503: "receiver's desktop notification service is unavailable"}
        return False, "{}: HTTP {} ({})".format(target, exc.code, details.get(exc.code, "request rejected"))
    except (OSError, URLError, HTTPException, ValueError, RecursionError) as exc:
        return False, "{}: {}".format(target, exc)


def send(args):
    key = read_key(args.key_file) if args.key_file is not None else None
    data = validate_message({"title": args.title, "message": args.message,
                             "urgency": args.urgency, "duration": args.duration})
    body = json.dumps(data, ensure_ascii=False).encode("utf-8")
    targets = expand_targets([args.target] + args.also)
    delivered = 0
    with ThreadPoolExecutor(max_workers=args.workers) as executor:
        for ok, report in executor.map(lambda target: send_one(target, key, body), targets):
            print(report, file=sys.stdout if ok else sys.stderr, flush=True)
            delivered += int(ok)
    failed = len(targets) - delivered
    print("Finished: {}/{} targets accepted the notification; {} failed.".format(
        delivered, len(targets), failed), flush=True)
    return 1 if failed else 0


def desktop_quote(value):
    # Desktop Entry Exec quoting has two layers: general escaping and argument escaping.
    value = str(value).replace("%", "%%")
    value = re.sub(r'([\\"`$])', r'\\\1', value)
    value = value.replace("\\", "\\\\").replace("\n", r"\n").replace("\r", r"\r")
    return '"' + value + '"'


def autostart(args):
    if not sys.platform.startswith("linux"):
        raise ValueError("Desktop autostart requires Linux.")
    path = config_dir() / "autostart" / "notify.desktop"
    if args.disable:
        if path.exists():
            path.unlink()
        print("Autostart disabled. Stop any running receiver with Ctrl+C or log out.")
        return 0
    if args.key_file is not None:
        read_key(args.key_file)
    script = Path(__file__).resolve()
    argv = [sys.executable, script, "listen", "--host", args.host, "--port", str(args.port)]
    if args.key_file is not None:
        argv.extend(["--key-file", Path(args.key_file).expanduser().resolve()])
    command = " ".join(desktop_quote(arg) for arg in argv)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("[Desktop Entry]\nType=Application\nName=notify\n"
                    "Comment=Receive desktop messages\n"
                    "Exec=" + command + "\nTerminal=false\n", encoding="utf-8")
    print("Enabled desktop login autostart: {}".format(path))
    print("It starts at your next desktop login. To start now, run 'notify listen'.")
    return 0


def port_number(value):
    port = int(value)
    if not 1 <= port <= 65535:
        raise argparse.ArgumentTypeError("port must be between 1 and 65535")
    return port


def worker_count(value):
    workers = int(value)
    if not 1 <= workers <= 64:
        raise argparse.ArgumentTypeError("workers must be between 1 and 64")
    return workers


def receiver_main(argv=None):
    parser = argparse.ArgumentParser(prog="notify", description="Receive desktop notifications only; send messages from the controller.")
    commands = parser.add_subparsers(dest="command", required=True)
    listen_parser = commands.add_parser("listen", help="receive messages on this Linux desktop")
    listen_parser.add_argument("--background", action="store_true", help="start a detached receiver and return")
    listen_parser.add_argument("--if-desktop", action="store_true", help="with --background, wait for login if no desktop is active")
    listen_parser.set_defaults(func=listen)
    start_parser = commands.add_parser("autostart", help="enable the receiver at desktop login")
    start_parser.add_argument("--disable", action="store_true", help="remove the login autostart entry")
    start_parser.set_defaults(func=autostart)
    for command in (listen_parser, start_parser):
        command.add_argument("--key-file", type=Path, help="enable optional shared-key authentication using this file")
        command.add_argument("--host", default="0.0.0.0", help="IPv4 bind address (default: all interfaces)")
        command.add_argument("--port", type=port_number, default=PORT)
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except (OSError, ValueError) as exc:
        print("notify: {}".format(exc), file=sys.stderr)
        return 1


def main(argv=None):
    parser = argparse.ArgumentParser(prog="notify", description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    key_parser = commands.add_parser("keygen", help="create a shared key (once, then copy it)")
    key_parser.set_defaults(func=keygen)
    listen_parser = commands.add_parser("listen", help="receive messages on this Linux desktop")
    listen_parser.add_argument("--background", action="store_true", help="start a detached receiver and return")
    listen_parser.add_argument("--if-desktop", action="store_true", help="with --background, wait for login if no desktop is active")
    listen_parser.set_defaults(func=listen)
    send_parser = commands.add_parser("send", help="send a pop-up message")
    all_parser = commands.add_parser("all", help="notify every address in supplied targets, ranges, or lists")
    for command, workers in ((send_parser, 1), (all_parser, 16)):
        command.add_argument("target", help="receiver hostname/IP or IPv4 pattern (e.g. 10.1-13.1.(10,20)), optionally with :port")
        command.add_argument("message", help="message text (put it in quotes)")
        command.add_argument("--also", action="append", default=[], metavar="HOST", help="another receiver or IPv4 pattern; repeat for multiple targets")
        command.add_argument("--title", default="Message")
        command.add_argument("--urgency", choices=("low", "normal", "critical"), default="normal")
        command.add_argument("--duration", type=int, default=8, metavar="SECONDS", help="requested popup duration, 1-300 (default: 8)")
        command.add_argument("--workers", type=worker_count, default=workers, help="concurrent deliveries, 1-64 (default: %(default)s)")
        command.set_defaults(func=send)
    start_parser = commands.add_parser("autostart", help="enable the receiver at desktop login")
    start_parser.add_argument("--disable", action="store_true", help="remove the login autostart entry")
    start_parser.set_defaults(func=autostart)
    key_parser.add_argument("--key-file", type=Path, default=default_key(), help="key output file (default: %(default)s)")
    for command in (listen_parser, send_parser, all_parser, start_parser):
        command.add_argument("--key-file", type=Path, help="enable optional shared-key authentication using this file")
    for command in (listen_parser, start_parser):
        command.add_argument("--host", default="0.0.0.0", help="IPv4 bind address (default: all interfaces)")
        command.add_argument("--port", type=port_number, default=PORT)
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except (OSError, ValueError) as exc:
        print("notify: {}".format(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
